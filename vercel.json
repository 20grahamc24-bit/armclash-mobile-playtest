{
  "cleanUrls": true,
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/Build/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/Build/(.*).wasm.unityweb", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Content-Encoding", "value": "gzip" }] },
    { "source": "/Build/(.*).framework.js.unityweb", "headers": [{ "key": "Content-Type", "value": "application/javascript" }, { "key": "Content-Encoding", "value": "gzip" }] },
    { "source": "/Build/(.*).data.unityweb", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Content-Encoding", "value": "gzip" }] }
  ]
}
